# This dependency tree predates npm 7. Several packages declare peer ranges that
# were never updated for the versions actually pinned here:
#
#   babel-loader 7.1.1         peer webpack "2 || 3"     pinned webpack 4.43.0
#   eslint-plugin-react 6.8.0  peer eslint  "^2 || ^3"   pinned eslint 4.18.2
#
# npm 6 ignored this, with npm 7+ it results in a fatal ERESOLVE, which makes the
# committed lockfile uninstallable. Set this setting as a TEMPORARY WORKAROUND
# to get things working again until we update the dependency stack.
legacy-peer-deps=true
